generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Child {
  id                String   @id
  nome              String
  data_nascimento   DateTime
  bairro            String
  responsavel       String

  revisado          Boolean  @default(false)
  revisado_por      String?
  revisado_em       DateTime?

  saude             Saude?
  educacao          Educacao?
  assistencia       AssistenciaSocial?

  alertas           Alerta[]
}

model Saude {
  id               Int      @id @default(autoincrement())
  childId          String   @unique
  ultima_consulta  DateTime
  vacinas_em_dia   Boolean

  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Educacao {
  id                  Int    @id @default(autoincrement())
  childId             String @unique
  escola              String?
  frequencia_percent  Int?

  child               Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model AssistenciaSocial {
  id               Int     @id @default(autoincrement())
  childId          String  @unique
  cad_unico        Boolean
  beneficio_ativo  Boolean

  child            Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Alerta {
  id       Int    @id @default(autoincrement())
  tipo     String
  area     String
  childId  String

  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Historico {
  id       Int    @id @default(autoincrement())
  tipo     String
  valor    Int
  criado_em DateTime @default(now())
}